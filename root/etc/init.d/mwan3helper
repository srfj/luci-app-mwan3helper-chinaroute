#!/bin/sh /etc/rc.common
# Copyright (c) 2011-2026 OpenWrt.org
#
# MWAN3 Helper - policy-routing helper for MWAN3 (chinaroute)
#
# OpenWrt 25.12 uses firewall4 (nftables) by default. The packet marking is
# still done through the iptables userspace frontend, which on 25.12 is
# provided by iptables-nft (NFT-backed). The "iptables" rules that fw4 does
# not own are kept in their own nft tables and survive a fw4 reload, so the
# legacy /etc/firewall.user hook is no longer needed.

START=60

USE_PROCD=1

IPTABLES=/usr/sbin/iptables

start_service() {
	local en dns dev dnsen mode dnsserver

	# (Re)generate the China / ISP IP sets.
	[ -x /etc/mwan3helper/genipset.sh ] && {
		/etc/mwan3helper/genipset.sh cn     '/etc/mwan3helper/all_cn.txt'
		/etc/mwan3helper/genipset.sh ct     '/etc/mwan3helper/chinatelecom.txt'
		/etc/mwan3helper/genipset.sh cnc    '/etc/mwan3helper/unicom_cnc.txt'
		/etc/mwan3helper/genipset.sh cmcc   '/etc/mwan3helper/cmcc.txt'
		/etc/mwan3helper/genipset.sh crtc   '/etc/mwan3helper/crtc.txt'
		/etc/mwan3helper/genipset.sh cernet '/etc/mwan3helper/cernet.txt'
		/etc/mwan3helper/genipset.sh gwbn   '/etc/mwan3helper/gwbn.txt'
		/etc/mwan3helper/genipset.sh othernet '/etc/mwan3helper/othernet.txt'
	}

	en=$(uci -q get mwan3helper.config.enabled)
	[ "$en" = "1" ] || return 0

	dns=$(uci -q get mwan3helper.config.dns)
	dev=$(uci -q get mwan3helper.config.dev)
	dnsen=$(uci -q get mwan3helper.config.dnsen)
	mode=$(uci -q get mwan3helper.config.mode)
	dnsserver=$(uci -q get mwan3helper.config.dnsserver)

	if [ -z "$dns" ] || [ -z "$dev" ]; then
		logger -t mwan3helper "missing dns/dev, nothing to do"
		return 0
	fi

	# GFW domain based DNS anti-pollution.
	mkdir -p /tmp/etc/dnsmasq-mwan3.d /tmp/dnsmasq.d
	if [ "$dnsen" = "1" ] && [ -n "$dnsserver" ]; then
		awk '!/^$/ && !/^#/ {printf("ipset=/.%s/gfwlist\n", $0)}' \
			/etc/mwan3helper/gfw.txt > /tmp/etc/dnsmasq-mwan3.d/mwan3_gfwlist.conf
		awk -v srv="$dnsserver" '!/^$/ && !/^#/ {printf("server=/.%s/%s#53\n", $0, srv)}' \
			/etc/mwan3helper/gfw.txt >> /tmp/etc/dnsmasq-mwan3.d/mwan3_gfwlist.conf
		echo "conf-dir=/tmp/etc/dnsmasq-mwan3.d" > /tmp/dnsmasq.d/dnsmasq-mwan3.conf
	else
		rm -f /tmp/dnsmasq.d/dnsmasq-mwan3.conf
		rm -f /tmp/etc/dnsmasq-mwan3.d/mwan3_gfwlist.conf
	fi
	/etc/init.d/dnsmasq restart

	# Dedicated routing table for the marked traffic.
	ipset -N gfwlist hash:net 2>/dev/null
	ip route del default table 200 2>/dev/null
	ip route add default via "$dns" dev "$dev" table 200
	ip rule del fwmark 200 table 200 2>/dev/null
	ip rule add table 200 fwmark 200

	# Remove any previously installed marking rules before re-adding them.
	$IPTABLES -t mangle -D PREROUTING -i br-lan -j MARK --set-mark 200 2>/dev/null
	$IPTABLES -t mangle -D PREROUTING -i br-lan -m set --match-set cn dst -j MARK --set-mark 0 2>/dev/null
	$IPTABLES -t mangle -D PREROUTING -s "$dns" -j MARK --set-mark 0 2>/dev/null
	$IPTABLES -t mangle -D PREROUTING -i br-lan -m set --match-set gfwlist dst -j MARK --set-mark 200 2>/dev/null

	if [ "$mode" = "0" ]; then
		# "Foreign traffic" mode: everything is marked, CN ranges are excluded.
		$IPTABLES -t mangle -A PREROUTING -i br-lan -j MARK --set-mark 200
		$IPTABLES -t mangle -A PREROUTING -i br-lan -m set --match-set cn dst -j MARK --set-mark 0
	fi
	# "GFW list" mode only marks destinations that resolved to the gfwlist set.
	$IPTABLES -t mangle -A PREROUTING -i br-lan -m set --match-set gfwlist dst -j MARK --set-mark 200
	# Never hijack the traffic originated by the helper's own DNS server.
	$IPTABLES -t mangle -A PREROUTING -s "$dns" -j MARK --set-mark 0

	# A few well-known ranges that must always be routed through the gateway.
	ipset -! add gfwlist 91.108.4.0/22
	ipset -! add gfwlist 91.108.8.0/22
	ipset -! add gfwlist 91.108.56.0/22
	ipset -! add gfwlist 95.161.64.0/20
	ipset -! add gfwlist 149.154.160.0/22
	ipset -! add gfwlist 149.154.164.0/22
}

stop_service() {
	rm -f /tmp/dnsmasq.d/dnsmasq-mwan3.conf
	/etc/init.d/dnsmasq restart

	ip route del default table 200 2>/dev/null
	ip rule del fwmark 200 table 200 2>/dev/null

	$IPTABLES -t mangle -D PREROUTING -i br-lan -j MARK --set-mark 200 2>/dev/null
	$IPTABLES -t mangle -D PREROUTING -i br-lan -m set --match-set cn dst -j MARK --set-mark 0 2>/dev/null
	$IPTABLES -t mangle -D PREROUTING -s "$(uci -q get mwan3helper.config.dns)" -j MARK --set-mark 0 2>/dev/null
	$IPTABLES -t mangle -D PREROUTING -i br-lan -m set --match-set gfwlist dst -j MARK --set-mark 200 2>/dev/null
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "mwan3helper"
}
